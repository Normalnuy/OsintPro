<Window x:Class="OsintPro.UI.Views.CompareDossiersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Порівняння досьє" Height="520" Width="720"
        WindowStartupLocation="CenterOwner" Background="#121212" Foreground="White"
        WindowStyle="None" ResizeMode="CanResize">

    <Border Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="16" Margin="8">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="📊 Порівняння досьє" FontSize="20" FontWeight="Bold" Foreground="#00C6FF" Margin="0,0,0,16"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="CompareText" IsReadOnly="True" TextWrapping="Wrap" Background="#1A1A1A" Foreground="#DDD"
                         BorderBrush="#333" BorderThickness="1" Padding="14" FontFamily="Consolas" FontSize="12"/>
            </ScrollViewer>

            <Button Grid.Row="2" Content="Закрити" Click="Close_Click" Width="120" Height="38" HorizontalAlignment="Right"
                    Margin="0,16,0,0" Background="#0072FF" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}"/>
        </Grid>
    </Border>
</Window>