<Window x:Class="OsintPro.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Icon="/logo.ico"
        Title="Justin OSINT" Height="850" Width="1200"
        Background="#121212" Foreground="White" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" WindowState="Maximized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00C6FF"/>
                                <Setter Property="Foreground" Value="#00C6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1A1A1A"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#0072FF"/>
                                <Setter Property="Foreground" Value="#0072FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF4444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2A0000"/>
                                <Setter Property="Foreground" Value="#FF6666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4A0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelAllButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D1111"/>
            <Setter Property="Foreground" Value="#FF6666"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF4444"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4A1111"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6A1111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#333333" CornerRadius="4" Margin="2,0,2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#00C6FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#0072FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShimmerEffect" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="-1,0" EndPoint="2,0">
                        <GradientStop Color="#1A1A1A" Offset="0"/>
                        <GradientStop Color="#2D2D2D" Offset="0.5"/>
                        <GradientStop Color="#1A1A1A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <PointAnimation Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.StartPoint)" From="-1,0" To="1,0" Duration="0:0:1.5"/>
                            <PointAnimation Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.EndPoint)" From="0,0" To="2,0" Duration="0:0:1.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chip" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="10" Padding="12,7" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box" Width="15" Height="15" CornerRadius="4" BorderBrush="#3A3A3A" BorderThickness="1" Background="#121212" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path x:Name="CheckMark" Data="M 2,5 L 5,9 L 11,2" Stroke="#00C6FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Margin="1,0,0,1"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#0072FF"/>
                                <Setter TargetName="Chip" Property="Background" Value="#142030"/>
                                <Setter Property="Foreground" Value="#00C6FF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#00C6FF"/>
                                <Setter TargetName="Box" Property="Background" Value="#0D1A28"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#444444"/>
                                <Setter TargetName="Chip" Property="Background" Value="#222222"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#00C6FF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#00C6FF"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252526"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00C6FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#142030"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0072FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModuleRefreshButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A2838"/>
                                <Setter Property="Foreground" Value="#00C6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#142030"/>
                                <Setter Property="Foreground" Value="#0072FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionMetaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ArchiveSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#0072FF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="ArchiveDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource CancelAllButtonStyle}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#121212">
            <TextBlock Text="" Foreground="#555555" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="12" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Width="45" FontSize="14" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click"/>
                <Button Content="☐" Width="45" FontSize="16" Style="{StaticResource TitleBarButtonStyle}" Click="BtnMaximize_Click"/>
                <Button Content="✕" Width="45" FontSize="14" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Ellipse Grid.ColumnSpan="2" Width="600" Height="600" Fill="#1A237E" Margin="0,0,-200,-200" VerticalAlignment="Bottom" HorizontalAlignment="Right" Opacity="0.15">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>

            <Border Grid.Column="0" Background="#181818" Padding="15" BorderBrush="#252526" BorderThickness="0,0,1,0">
                <StackPanel>
                    <Viewbox Width="85" Height="85" HorizontalAlignment="Center" Margin="0,15,0,10">
                        <Viewbox.Effect>
                            <DropShadowEffect Color="#00C6FF" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
                        </Viewbox.Effect>
                        <Canvas Width="100" Height="100">
                            <Polygon Points="10,40 45,55 35,15" Fill="#0072FF" Opacity="0.8"/>
                            <Polygon Points="10,40 45,55 30,65" Fill="#005bb5" Opacity="0.6"/>
                            <Polygon Points="90,30 55,55 65,10" Fill="#00C6FF" Opacity="0.9"/>
                            <Polygon Points="90,30 55,55 75,55" Fill="#0099cc" Opacity="0.7"/>
                            <Polygon Points="45,55 55,55 50,90" Fill="#00C6FF" Opacity="0.9"/>
                            <Polygon Points="45,55 55,55 65,35 40,30" Fill="#0072FF" Opacity="0.9"/>
                            <Polygon Points="40,30 25,25 45,40" Fill="#00C6FF"/>
                        </Canvas>
                    </Viewbox>

                    <TextBlock Text="JUSTIN OSINT" FontSize="22" FontWeight="Black" Margin="0,0,0,40" HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00C6FF" Offset="0.0" />
                                <GradientStop Color="#0072FF" Offset="1.0" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#0072FF" BlurRadius="10" ShadowDepth="4" Direction="315" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <Button x:Name="BtnNewSearch" Height="45" Margin="0,5" Style="{StaticResource SidebarButtonStyle}" Click="BtnNewSearch_Click">
                        <TextBlock Text="🔍 Новий пошук"/>
                    </Button>

                    <Button x:Name="BtnOpenArchive" Height="45" Margin="0,5" Style="{StaticResource SidebarButtonStyle}" Click="BtnOpenArchive_Click">
                        <TextBlock Text="📂 Архів досьє"/>
                    </Button>

                    <Button x:Name="BtnCheckUpdates" Height="45" Margin="0,5" Style="{StaticResource SidebarButtonStyle}" Click="BtnCheckUpdates_Click">
                        <TextBlock Text="🔄 Оновлення"/>
                    </Button>

                    <Button x:Name="BtnSettings" Height="45" Margin="0,5" Style="{StaticResource SidebarButtonStyle}" Click="BtnSettings_Click">
                        <TextBlock Text="⚙️ Налаштування"/>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="30">
                <Grid x:Name="SearchGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,25">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="#1E1E1E" CornerRadius="15" Padding="15,5" Margin="0,0,12,12" Height="50" BorderBrush="#2A2A2A" BorderThickness="1">
                                <Grid>
                                    <TextBlock IsHitTestVisible="False" Text="Прізвище *" VerticalAlignment="Center" Foreground="#555555">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=LastNameBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="LastNameBox" TextChanged="NameBox_TextChanged" Foreground="White" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="14" CaretBrush="#0072FF"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Background="#1E1E1E" CornerRadius="15" Padding="15,5" Margin="0,0,12,12" Height="50" BorderBrush="#2A2A2A" BorderThickness="1">
                                <Grid>
                                    <TextBlock IsHitTestVisible="False" Text="Ім'я *" VerticalAlignment="Center" Foreground="#555555">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=FirstNameBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="FirstNameBox" TextChanged="NameBox_TextChanged" Foreground="White" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="14" CaretBrush="#0072FF"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Background="#1E1E1E" CornerRadius="15" Padding="15,5" Margin="0,0,12,12" Height="50" BorderBrush="#2A2A2A" BorderThickness="1">
                                <Grid>
                                    <TextBlock IsHitTestVisible="False" Text="По батькові" VerticalAlignment="Center" Foreground="#555555">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PatronymicBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="PatronymicBox" TextChanged="NameBox_TextChanged" Foreground="White" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="14" CaretBrush="#0072FF"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Background="#1E1E1E" CornerRadius="15" Padding="15,5" Margin="0,0,12,12" Height="50" BorderBrush="#2A2A2A" BorderThickness="1">
                                <Grid>
                                    <TextBlock IsHitTestVisible="False" Text="РНОКПП (ІПН)" VerticalAlignment="Center" Foreground="#555555">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=InnBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="InnBox" Foreground="White" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="14" CaretBrush="#0072FF"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Background="#1E1E1E" CornerRadius="15" Padding="15,5" Margin="0,0,12,12" Height="50" BorderBrush="#2A2A2A" BorderThickness="1">
                                <Grid>
                                    <TextBlock IsHitTestVisible="False" Text="Нікнейм (без @)" VerticalAlignment="Center" Foreground="#555555">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=NicknameBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="NicknameBox" Foreground="White" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="14" CaretBrush="#0072FF"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2" Background="#1E1E1E" CornerRadius="15" Padding="15,5" Margin="0,0,12,12" Height="50" BorderBrush="#2A2A2A" BorderThickness="1">
                                <Grid>
                                    <TextBlock IsHitTestVisible="False" Text="Дата народження (ДД.ММ.РРРР)" VerticalAlignment="Center" Foreground="#555555">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DobBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="DobBox" MaxLength="10" TextChanged="DobBox_TextChanged" Foreground="White" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="14" CaretBrush="#0072FF"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#1E1E1E" CornerRadius="15" Padding="15,5" Margin="0,0,12,12" Height="50" BorderBrush="#2A2A2A" BorderThickness="1">
                                <Grid>
                                    <TextBlock IsHitTestVisible="False" Text="Телефон або Email" VerticalAlignment="Center" Foreground="#555555">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ContactBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="ContactBox" Foreground="White" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="14" CaretBrush="#0072FF"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Margin="5,0,0,12" VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="45"/>
                                </Grid.RowDefinitions>

