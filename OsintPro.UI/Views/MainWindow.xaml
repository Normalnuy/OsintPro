                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="GenericCard_Click" Background="#222222" Margin="0,0,10,10" Width="350" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="CardBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="12" BorderBrush="{Binding CardColor}" BorderThickness="3,0,0,0">
                                                                <Grid>
                                                                    <StackPanel x:Name="NormalView">
                                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                                                        <TextBlock Text="{Binding Subtitle1}" Foreground="#00C6FF" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Subtitle2}" Foreground="#888888" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="SkeletonView" Visibility="Collapsed">
                                                                        <Border Height="14" Width="160" CornerRadius="4" HorizontalAlignment="Left" Style="{StaticResource ShimmerEffect}" Margin="0,0,0,8"/>
                                                                        <Border Height="10" Width="100" CornerRadius="3" HorizontalAlignment="Left" Style="{StaticResource ShimmerEffect}" Margin="0,0,0,6"/>
                                                                        <Border Height="10" Width="220" CornerRadius="3" HorizontalAlignment="Left" Style="{StaticResource ShimmerEffect}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CardBorder" Property="Background" Value="#2A2A2A"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding Title}" Value="⏳ Очікування...">
                                                                    <Setter TargetName="NormalView" Property="Visibility" Value="Collapsed"/>
                                                                    <Setter TargetName="SkeletonView" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="0"/>
                                                                    <Setter TargetName="CardBorder" Property="Background" Value="#161616"/>
                                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A1A1A" CornerRadius="15" Margin="0,0,0,15" Padding="15" BorderBrush="#252526" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="📱 Соціальні мережі та згадки" FontSize="15" FontWeight="Bold" Foreground="#00C6FF"/>
                                            <TextBlock x:Name="SocialSectionMeta" Style="{StaticResource SectionMetaTextStyle}"/>
                                        </StackPanel>
                                        <Button Content="🛑 Скасувати" Click="BtnCancelSocial_Click" Style="{StaticResource SectionCancelButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ItemsControl x:Name="SocialList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="GenericCard_Click" Background="#222222" Margin="0,0,10,10" Width="350" HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="CardBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="12" BorderBrush="{Binding CardColor}" BorderThickness="3,0,0,0">
                                                                <Grid>
                                                                    <StackPanel x:Name="NormalView">
                                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                                                        <TextBlock Text="{Binding Subtitle1}" Foreground="#00C6FF" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Subtitle2}" Foreground="#888888" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="SkeletonView" Visibility="Collapsed">
                                                                        <Border Height="14" Width="160" CornerRadius="4" HorizontalAlignment="Left" Style="{StaticResource ShimmerEffect}" Margin="0,0,0,8"/>
                                                                        <Border Height="10" Width="100" CornerRadius="3" HorizontalAlignment="Left" Style="{StaticResource ShimmerEffect}" Margin="0,0,0,6"/>
                                                                        <Border Height="10" Width="220" CornerRadius="3" HorizontalAlignment="Left" Style="{StaticResource ShimmerEffect}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CardBorder" Property="Background" Value="#2A2A2A"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding Title}" Value="⏳ Очікування...">
                                                                    <Setter TargetName="NormalView" Property="Visibility" Value="Collapsed"/>
                                                                    <Setter TargetName="SkeletonView" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="0"/>
                                                                    <Setter TargetName="CardBorder" Property="Background" Value="#161616"/>
                                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ArchiveGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📂 АРХІВ ЗБЕРЕЖЕНИХ ДОСЬЄ" FontSize="22" FontWeight="Bold" Foreground="#00C6FF" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="12" Padding="14,0" Height="44" BorderBrush="#2A2A2A" BorderThickness="1">
                            <Grid>
                                <TextBlock IsHitTestVisible="False" Text="🔍 Пошук у архіві..." VerticalAlignment="Center" Foreground="#555555" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ArchiveSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="ArchiveSearchBox" Style="{StaticResource ArchiveSearchTextBoxStyle}" TextChanged="ArchiveSearchBox_TextChanged"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnCompareArchive" Content="📊 Порівняти" Click="BtnCompareArchive_Click" Style="{StaticResource ArchiveDeleteButtonStyle}" Margin="10,0,0,0" ToolTip="Оберіть два досьє (клік по плитці, потім Порівняти)"/>
                            <Button Grid.Column="1" x:Name="BtnDeleteArchive" Content="🗑 Видалити" Click="BtnDeleteArchive_Click" Style="{StaticResource ArchiveDeleteButtonStyle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ArchiveTilesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="280" Margin="0,0,15,15" Background="#1E1E1E" CornerRadius="15" Padding="18" BorderBrush="#333" BorderThickness="1" MouseLeftButtonDown="ArchiveTile_Select">
                                        <Grid>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="🗑" Click="ArchiveDeleteTile_Click" Tag="{Binding}" Width="28" Height="28" Margin="0,-6,-6,0" Background="Transparent" Foreground="#666" BorderThickness="0" FontSize="12" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Видалити досьє">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="delBorder" Background="Transparent" CornerRadius="6" Padding="4">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="delBorder" Property="Background" Value="#3A1515"/>
                                                                            <Setter Property="Foreground" Value="#FF6666"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <StackPanel>
                                                <TextBlock Text="👤" FontSize="24" Margin="0,0,0,10"/>
                                                <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="16" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding DateCreated, StringFormat='Створено: dd.MM.yyyy HH:mm'}" Foreground="#888" FontSize="11" Margin="0,5,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Button Content=" ВІДКРИТИ " Click="ArchiveTile_Open_Click" Tag="{Binding}" Padding="10,4" FontSize="10" FontWeight="Bold" Foreground="White" Background="#0072FF" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,6,0">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="5"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                    <Button Content="↻ Оновити" Click="ArchiveTile_Rerun_Click" Tag="{Binding}" Padding="10,4" FontSize="10" FontWeight="Bold" Foreground="#00C6FF" Background="#1A2A33" BorderBrush="#0072FF" BorderThickness="1" Cursor="Hand" FocusVisualStyle="{x:Null}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="EditorGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <Button Content="⬅ Назад до архіву" Click="BtnBackToArchive_Click" Background="Transparent" Foreground="#888" BorderThickness="0" Cursor="Hand" DockPanel.Dock="Left" FocusVisualStyle="{x:Null}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="💾 Зберегти зміни" Click="BtnSaveEditor_Click" Background="#32CD32" Foreground="White" FontWeight="Bold" Width="140" Height="40" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="📄 Експорт в PDF" Click="BtnExportPdf_Click" Background="#FF3366" Foreground="White" FontWeight="Bold" Width="140" Height="40" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="EditorTitle" Text="Редагування досьє" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,15,0">
                            <StackPanel.Resources>
                                <DataTemplate x:Key="EditableCardTemplate">
                                    <Border Background="#222" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#333" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#00C6FF" BorderThickness="0,0,0,1" BorderBrush="#444" FontWeight="Bold" Margin="0,0,0,5" Padding="0,0,0,5"/>
                                                <TextBox Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#CCC" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" Padding="0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="❌" Tag="{Binding}" Click="BtnDeleteItem_Click" Width="30" Height="30" Background="#FF4444" Foreground="White" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" FocusVisualStyle="{x:Null}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </StackPanel.Resources>

                            <TextBlock Text="📝 Власні нотатки" FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,5"/>
                            <TextBox x:Name="EditorNotes" Height="100" AcceptsReturn="True" TextWrapping="Wrap" Background="#1A1A1A" Foreground="White" BorderThickness="1" BorderBrush="#333" Padding="10" Margin="0,0,0,20" FontSize="14"/>

                            <TextBlock Text="🛡️ Миротворец" FontWeight="Bold" Foreground="#00C6FF" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="EditorSecurity" ItemTemplate="{StaticResource EditableCardTemplate}"/>
                            <Button Content="+ Додати інформацію вручну" Click="BtnAddSecurity_Click" HorizontalAlignment="Left" Background="#007ACC" Foreground="White" Padding="10,5" BorderThickness="0" Margin="0,0,0,20" Cursor="Hand" FocusVisualStyle="{x:Null}"/>

                            <TextBlock Text="⚖️ Судові справи" FontWeight="Bold" Foreground="#00C6FF" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="EditorCourts" ItemTemplate="{StaticResource EditableCardTemplate}"/>
                            <Button Content="+ Додати справу вручну" Click="BtnAddCourt_Click" HorizontalAlignment="Left" Background="#007ACC" Foreground="White" Padding="10,5" BorderThickness="0" Margin="0,0,0,20" Cursor="Hand" FocusVisualStyle="{x:Null}"/>

                            <TextBlock Text="💰 Борги та штрафи" FontWeight="Bold" Foreground="#00C6FF" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="EditorDebts" ItemTemplate="{StaticResource EditableCardTemplate}"/>
                            <Button Content="+ Додати борг вручну" Click="BtnAddDebt_Click" HorizontalAlignment="Left" Background="#007ACC" Foreground="White" Padding="10,5" BorderThickness="0" Margin="0,0,0,20" Cursor="Hand" FocusVisualStyle="{x:Null}"/>

                            <TextBlock Text="🏢 Бізнес та зв'язки" FontWeight="Bold" Foreground="#00C6FF" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="EditorBusiness" ItemTemplate="{StaticResource EditableCardTemplate}"/>
                            <Button Content="+ Додати бізнес вручну" Click="BtnAddBusiness_Click" HorizontalAlignment="Left" Background="#007ACC" Foreground="White" Padding="10,5" BorderThickness="0" Margin="0,0,0,20" Cursor="Hand" FocusVisualStyle="{x:Null}"/>

                            <TextBlock Text="📄 Декларації НАЗК" FontWeight="Bold" Foreground="#00C6FF" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="EditorDeclarations" ItemTemplate="{StaticResource EditableCardTemplate}"/>
                            <Button Content="+ Додати декларацію вручну" Click="BtnAddDeclaration_Click" HorizontalAlignment="Left" Background="#007ACC" Foreground="White" Padding="10,5" BorderThickness="0" Margin="0,0,0,20" Cursor="Hand" FocusVisualStyle="{x:Null}"/>

                            <TextBlock Text="🛒 Маркетплейси" FontWeight="Bold" Foreground="#00C6FF" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="EditorMarket" ItemTemplate="{StaticResource EditableCardTemplate}"/>
                            <Button Content="+ Додати маркетплейс вручну" Click="BtnAddMarket_Click" HorizontalAlignment="Left" Background="#007ACC" Foreground="White" Padding="10,5" BorderThickness="0" Margin="0,0,0,20" Cursor="Hand" FocusVisualStyle="{x:Null}"/>

                            <TextBlock Text="📱 Соціальні мережі та згадки" FontWeight="Bold" Foreground="#00C6FF" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="EditorSocial" ItemTemplate="{StaticResource EditableCardTemplate}"/>
                            <Button Content="+ Додати соцмережу вручну" Click="BtnAddSocial_Click" HorizontalAlignment="Left" Background="#007ACC" Foreground="White" Padding="10,5" BorderThickness="0" Margin="0,0,0,40" Cursor="Hand" FocusVisualStyle="{x:Null}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Popup x:Name="DetailPopup" Placement="Center" AllowsTransparency="True" StaysOpen="False">
            <Border Background="#121215" BorderBrush="#5500C6FF" BorderThickness="1.5" CornerRadius="16" Width="620" Padding="28">
                <Border.Effect>
                    <DropShadowEffect Color="#00C6FF" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="PopupTitle" FontSize="20" FontWeight="Bold" Foreground="#00C6FF" Margin="0,0,0,16"/>
                    <Border Grid.Row="1" Background="#0CFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14" MaxHeight="460">
                        <RichTextBox x:Name="PopupContent" Background="Transparent" Foreground="White" BorderThickness="0" IsReadOnly="True" FontSize="14" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    <Button Grid.Row="2" Content="Закрити" Click="ClosePopup_Click" Margin="0,20,0,0" Background="#0072FF" Foreground="White" FontWeight="Bold" Height="42" BorderBrush="#00C6FF" BorderThickness="1" Cursor="Hand" FocusVisualStyle="{x:Null}"/>
                </Grid>
            </Border>
        </Popup>

        <Grid x:Name="CaptchaOverlay" Visibility="Collapsed" Background="#CC000000" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <Border Background="#181818" BorderBrush="#FFD700" BorderThickness="1" CornerRadius="15" Width="450" Height="600" Padding="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="⚠️ Доведіть, що ви не робот" FontSize="18" FontWeight="Bold" Foreground="#FFD700" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Border Grid.Row="1" CornerRadius="8" Background="White" ClipToBounds="True" Margin="0,0,0,15">
                        <wv2:WebView2 x:Name="CaptchaWebView"/>
                    </Border>
                    <Button Grid.Row="2" Content="СКАСУВАТИ" Click="CancelCaptcha_Click" Background="#3E3E42" Foreground="White" Height="40" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>